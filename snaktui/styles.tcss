/* SnakTUI — neon arcade styling */

/* Fallbacks matching the Neon palette. The active theme (registered per
   palette in app.py build_theme) overrides these at runtime, so the chrome
   follows whichever theme the player picked. */
$snake-bg-a: #05010f;
$snake-bg-b: #0a0320;
$snake-frame: #2de2e6;
$snake-frame-dim: #155e6b;
$snake-accent: #ff2bd6;
$snake-accent2: #2de2e6;
$snake-text: #e6f1ff;
$snake-dim: #7183b0;
$snake-danger: #ff3b30;
$snake-golden: #ffd166;
$snake-panel: #070313;

Screen {
    background: $snake-bg-a;
    color: $snake-text;
}

/* ------------------------------------------------------------------ */
/* Main menu                                                           */
/* ------------------------------------------------------------------ */

#menu-root {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 1;
}

#menu-box {
    width: 96%;
    max-width: 60;
    height: auto;
    border: round $snake-frame;
    background: $snake-panel;
    padding: 1 2;
}

#menu-status {
    height: 1;
    text-align: center;
    margin-bottom: 1;
}

#menu-logo {
    height: 2;
    text-align: center;
}

#menu-tagline {
    height: 1;
    text-align: center;
    margin-top: 1;
}

#menu-rule {
    height: 1;
    text-align: center;
    margin: 1 0;
}

#menu-list {
    height: auto;
    text-align: center;
}

#menu-footer {
    height: 2;
    text-align: center;
    margin-top: 1;
}

/* ------------------------------------------------------------------ */
/* Game                                                                */
/* ------------------------------------------------------------------ */

#hud {
    height: 2;
    background: $snake-panel;
    padding: 0 1;
}

#game-body {
    height: 1fr;
    align: center middle;
    padding: 0 1;
}

SnakeBoard {
    border: round $snake-frame;
    background: $snake-bg-a;
}

#sidebar {
    width: 24;
    height: 1fr;
    max-height: 100%;
    background: $snake-panel;
    border: round $snake-accent;
    padding: 0 1;
    margin-left: 1;
}

#hint {
    height: 1;
    background: $snake-panel;
    color: $snake-dim;
    text-align: center;
    padding: 0 1;
}

/* ------------------------------------------------------------------ */
/* Modal screens                                                       */
/* ------------------------------------------------------------------ */

ModalScreen {
    background: $snake-bg-a;
}

.modal-root {
    width: 100%;
    height: 100%;
    align: center middle;
    padding: 1;
    background: $snake-bg-a;
}

.modal-box {
    width: 96%;
    max-width: 64;
    height: auto;
    border: round $snake-frame;
    background: $snake-panel;
    padding: 1 2;
}

.modal-box.tall {
    height: 100%;
    max-width: 76;
}

#gameover-title,
#scores-title,
#help-title,
#settings-title {
    height: auto;
    text-align: center;
    text-style: bold;
}

#gameover-reason {
    height: auto;
    text-align: center;
    margin-bottom: 1;
}

#gameover-stats {
    height: auto;
    margin-bottom: 1;
}

#gameover-actions {
    height: auto;
    margin-bottom: 1;
}

#gameover-hint,
#scores-hint,
#help-hint,
#settings-hint {
    height: 1;
    text-align: center;
    margin-top: 1;
}

#help-scroll {
    height: 1fr;
    margin-top: 1;
}

#scores-table,
#help-body {
    height: auto;
}

#scores-table {
    margin-top: 1;
}

#settings-list {
    height: auto;
    margin: 1 0;
}

#settings-message {
    height: 1;
    text-align: center;
}

.gameover-box {
    max-width: 56;
}

.settings-box {
    max-width: 56;
}

.scores-box {
    height: auto;
    max-height: 92%;
    max-width: 68;
}

ScrollableContainer {
    scrollbar-size-vertical: 1;
    scrollbar-color: $snake-frame;
    scrollbar-color-hover: $snake-accent;
    scrollbar-color-active: $snake-golden;
    scrollbar-background: $snake-panel;
}
